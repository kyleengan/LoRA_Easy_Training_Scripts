   <item row="2" column="0">
    <widget class="QCheckBox" name="immiscible_enable">
     <property name="toolTip">
      <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Immiscible noise pairing (KNN): for each image, k noise samples are drawn and the one closest to the image latent is used. Reported to speed up convergence. Works at any batch size. Not used by Flux.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
     </property>
     <property name="text">
      <string>Immiscible Noise</string>
     </property>
    </widget>
   </item>
   <item row="2" column="1">
    <layout class="QHBoxLayout" name="horizontalLayout_2">
     <item>
      <widget class="QLabel" name="label_4">
       <property name="toolTip">
        <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Number of noise candidates per image (k). Around 4-8 is a reasonable start; larger values pair more strongly.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
       </property>
       <property name="text">
        <string>Candidates (k)</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="SpinBox" name="immiscible_k_input">
       <property name="enabled">
