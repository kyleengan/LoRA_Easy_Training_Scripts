   </item>
   <item row="3" column="0">
    <widget class="QCheckBox" name="dream_enable">
     <property name="toolTip">
      <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;DREAM (experimental): adds one extra no-grad forward pass per step and trains on inputs rectified with the model's own prediction, reducing exposure bias. Roughly +25-35% time per step. Gains are proven only for super-resolution; A/B test it. SD 1.5 / SDXL LoRA only (not Flux or Textual Inversion).&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
     </property>
     <property name="text">
      <string>DREAM (experimental)</string>
     </property>
    </widget>
   </item>
   <item row="3" column="1">
    <layout class="QHBoxLayout" name="horizontalLayout_3">
     <item>
      <widget class="QLabel" name="label_5">
       <property name="toolTip">
        <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Detail preservation exponent p in lambda = sqrt(1 - alpha_bar)^p. 1.0 is the paper's best; values near 0 apply full strength at every timestep, larger values weaken the effect at low noise levels.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
       </property>
       <property name="text">
        <string>Detail Preservation (p)</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="DoubleSpinBox" name="dream_p_input">
       <property name="enabled">
        <bool>false</bool>
       </property>
       <property name="focusPolicy">
        <enum>Qt::StrongFocus</enum>
       </property>
       <property name="toolTip">
        <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Detail preservation exponent p in lambda = sqrt(1 - alpha_bar)^p. 1.0 is the paper's best; values near 0 apply full strength at every timestep, larger values weaken the effect at low noise levels.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
       </property>
       <property name="minimum">
        <double>0.050000000000000</double>
       </property>
